------------------------------------------------ 服务器部署使用
docker compose down
--删除镜像
docker compose down --rmi all

docker compose up -d
--强制重建
docker compose up -d --force-recreate


--单个镜像更新 --Docker pull 其实比对的是 digest（镜像内容哈希）
docker compose pull web
docker compose up -d --no-deps --force-recreate web



